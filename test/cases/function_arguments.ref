lbwhile1:
  lb r0 HASH("StructureBattery") Ratio Average
  slt r0 r0 0.2
  put db 510 r0
  jal set.enable.fuel.generator
  put db 510 6
  put db 509 5
  put db 508 4
  put db 507 3
  jal set.stack.entry
  j lbwhile1
set.enable.fuel.generator:
  get r1 db 510
  sb HASH("StructureSolidFuelGenerator") On r1
  j ra
set.stack.entry:
  get r1 db 510
  get r2 db 509
  get r3 db 508
  get r4 db 507
  put $BEEF 0 r1
  put $BEEF 1 r2
  put $BEEF 2 r3
  put $BEEF 3 r4
  j ra
